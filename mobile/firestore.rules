rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owns(uid) { return request.auth != null && request.auth.uid == uid; }
    function tally(d, field) { return d[field] is int && d[field] >= 0 && d[field] <= 10000000; }
    function validOwnVideo(videoId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'youtubeId', 'title', 'language', 'lines', 'createdAt', 'channel', 'seconds', 'status', 'note'])
        && d.keys().hasAll(['id', 'youtubeId', 'title', 'language', 'lines', 'createdAt'])
        && d.id == videoId && d.youtubeId == videoId && videoId.matches('^[A-Za-z0-9_-]{6,20}$')
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.language in ['en-US', 'ru-RU', 'es-ES', 'fr-FR', 'de-DE', 'it-IT', 'pt-BR', 'ja-JP']
        && d.lines is list && d.lines.size() <= 2000
        && d.createdAt is string && d.createdAt.size() <= 40
        && (!('channel' in d) || (d.channel is string && d.channel.size() <= 200))
        && (!('seconds' in d) || (d.seconds is int && d.seconds >= 0 && d.seconds <= 864000))
        && (!('status' in d) || d.status in ['pending', 'ready', 'none'])
        && (!('note' in d) || (d.note is string && d.note.size() <= 200));
    }
    function validActivity(activityId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'kind', 'source', 'sourceId', 'title', 'language', 'durationMs', 'createdAt'])
        && d.keys().hasAll(['id', 'kind', 'source', 'sourceId', 'title', 'language', 'durationMs', 'createdAt'])
        && d.id == activityId && activityId.matches('^[a-zA-Z0-9_-]{1,128}$')
        && d.kind in ['watch', 'recording']
        && d.source in ['lesson', 'video']
        && d.sourceId is string && d.sourceId.size() > 0 && d.sourceId.size() <= 160
        && d.title is string && d.title.size() <= 200
        && d.language in ['en-US', 'ru-RU', 'es-ES', 'fr-FR', 'de-DE', 'it-IT', 'pt-BR', 'ja-JP']
        && d.durationMs is int && d.durationMs >= 0 && d.durationMs <= 86400000
        && d.createdAt is string && d.createdAt.size() <= 40;
    }
    function validReading(readingId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'source', 'sourceId', 'title', 'language', 'level', 'complete', 'durationMs', 'wordsSpoken', 'accuracy', 'wordsExpected', 'wordsMatched', 'wordsInScript', 'speed', 'section', 'transcript', 'createdAt'])
        && d.keys().hasAll(['id', 'source', 'sourceId', 'title', 'language', 'level', 'complete', 'durationMs', 'wordsSpoken', 'accuracy', 'wordsExpected', 'wordsMatched', 'wordsInScript', 'transcript', 'createdAt'])
        && d.id == readingId && readingId.matches('^[a-zA-Z0-9_-]{1,128}$')
        && d.source in ['lesson', 'video']
        && d.sourceId is string && d.sourceId.size() > 0 && d.sourceId.size() <= 160
        && d.title is string && d.title.size() <= 200
        && d.language in ['en-US', 'ru-RU', 'es-ES', 'fr-FR', 'de-DE', 'it-IT', 'pt-BR', 'ja-JP']
        && d.level in ['all', 'keys', 'rest', 'openers']
        && d.complete is bool
        && tally(d, 'durationMs') && tally(d, 'wordsSpoken') && tally(d, 'wordsExpected') && tally(d, 'wordsMatched') && tally(d, 'wordsInScript')
        && d.accuracy is int && d.accuracy >= 0 && d.accuracy <= 100
        && (!('speed' in d) || (d.speed is int && d.speed >= 1 && d.speed <= 400))
        && (!('section' in d) || (d.section is map && d.section.keys().hasOnly(['from', 'to']) && d.section.from is int && d.section.to is int))
        && d.transcript is string && d.transcript.size() <= 20000
        && d.createdAt is string && d.createdAt.size() <= 40;
    }
    function validExample(example) {
      return example is map && example.keys().hasOnly(['text', 'translation'])
        && example.keys().hasAll(['text', 'translation'])
        && example.text is string && example.text.size() > 0 && example.text.size() <= 600
        && example.translation is string && example.translation.size() > 0 && example.translation.size() <= 2000;
    }
    function validEntry(entryId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'phrase', 'meaning', 'native', 'target', 'createdAt', 'due', 'interval', 'repetitions', 'history', 'conversationIds', 'example', 'suggestion', 'reviewed'])
        && d.keys().hasAll(['id', 'phrase', 'meaning', 'native', 'target', 'createdAt', 'due', 'interval', 'repetitions', 'history'])
        && d.id == entryId && entryId.matches('^[a-zA-Z0-9_-]{1,128}$')
        && d.phrase is string && d.phrase.size() > 0 && d.phrase.size() <= 80000
        && d.meaning is string && d.meaning.size() > 0 && d.meaning.size() <= 80000
        && (!('example' in d) || validExample(d.example))
        && d.native in ['en-US', 'ru-RU', 'es-ES', 'fr-FR', 'de-DE', 'it-IT', 'pt-BR', 'ja-JP']
        && d.target in ['en-US', 'ru-RU', 'es-ES', 'fr-FR', 'de-DE', 'it-IT', 'pt-BR', 'ja-JP']
        && d.createdAt is string && d.createdAt.size() <= 40
        && d.due is string && d.due.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.interval is int && d.interval >= 0
        && d.repetitions is int && d.repetitions >= 0
        && d.history is list && d.history.size() <= 1000
        && (!('conversationIds' in d) || (d.conversationIds is list && d.conversationIds.size() <= 500))
        && (!('reviewed' in d) || d.reviewed is bool)
        && (!('suggestion' in d) || (d.suggestion is map && d.suggestion.keys().hasOnly(['phrase', 'reason'])
          && d.suggestion.phrase is string && d.suggestion.phrase.size() > 0 && d.suggestion.phrase.size() <= 600
          && d.suggestion.reason is string && d.suggestion.reason.size() <= 600));
    }
    match /users/{uid}/dictionary/{entryId} {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid) && validEntry(entryId);
    }
    function validConversation(conversationId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'title', 'description', 'summary', 'summarySourceMessageId', 'outline', 'outlineSourceMessageId', 'outlinePoints', 'script', 'scriptMeanings', 'native', 'target', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['id', 'title', 'description', 'summary', 'summarySourceMessageId', 'native', 'target', 'createdAt', 'updatedAt'])
        && d.id == conversationId && conversationId.matches('^[a-zA-Z0-9_-]{1,128}$')
        && d.title is string && d.title.size() > 0 && d.title.size() <= 160
        && d.description is string && d.description.size() <= 2000
        && d.summary is string && d.summary.size() <= 6000
        && d.summarySourceMessageId is string && d.summarySourceMessageId.size() <= 128
        && (!('outline' in d) || (d.outline is string && d.outline.size() <= 12000))
        && (!('outlineSourceMessageId' in d) || (d.outlineSourceMessageId is string && d.outlineSourceMessageId.size() <= 128))
        && (!('outlinePoints' in d) || (d.outlinePoints is string && d.outlinePoints.size() <= 20000))
        && (!('script' in d) || (d.script is string && d.script.size() <= 16000))
        && (!('scriptMeanings' in d) || (d.scriptMeanings is list && d.scriptMeanings.size() <= 200))
        && d.native in ['en-US', 'ru-RU', 'es-ES', 'fr-FR', 'de-DE', 'it-IT', 'pt-BR', 'ja-JP']
        && d.target in ['en-US', 'ru-RU', 'es-ES', 'fr-FR', 'de-DE', 'it-IT', 'pt-BR', 'ja-JP']
        && d.createdAt is string && d.createdAt.size() <= 40
        && d.updatedAt is string && d.updatedAt.size() <= 40;
    }
    match /users/{uid}/savedConversations/{conversationId} {
      allow read: if owns(uid);
      allow create, update: if owns(uid) && validConversation(conversationId);
    }
    function validIssue(issueId) {
      let d = request.resource.data;
      return d.keys().hasOnly(['id', 'text', 'native', 'target', 'source', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['id', 'text', 'native', 'target', 'source', 'createdAt', 'updatedAt'])
        && d.id == issueId && issueId.matches('^[a-zA-Z0-9_-]{1,128}$')
        && d.text is string && d.text.size() > 0 && d.text.size() <= 2000
        && d.native in ['en-US', 'ru-RU', 'es-ES', 'fr-FR', 'de-DE', 'it-IT', 'pt-BR', 'ja-JP']
        && d.target in ['en-US', 'ru-RU', 'es-ES', 'fr-FR', 'de-DE', 'it-IT', 'pt-BR', 'ja-JP']
        && d.source == 'learner'
        && d.createdAt is string && d.createdAt.size() <= 40
        && d.updatedAt is string && d.updatedAt.size() <= 40;
    }
    // Things the learner wants to work on. Issues raised by the partner will be
    // written by the server, so a client can only create its own kind.
    match /users/{uid}/issues/{issueId} {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid) && validIssue(issueId);
    }
    // Live readings: a log of the learner reading aloud. Written once, never changed.
    match /users/{uid}/readings/{readingId} {
      allow read: if owns(uid);
      allow create: if owns(uid) && validReading(readingId);
    }
    // Videos the learner found and saved themselves, with the transcript once it arrives.
    match /users/{uid}/videos/{videoId} {
      allow read, delete: if owns(uid);
      allow create, update: if owns(uid) && validOwnVideo(videoId);
    }
    // Notes for the library's owner that a saved video has no transcript. Nobody reads them from the app.
    match /videoRequests/{requestId} {
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasOnly(['youtubeId', 'title', 'language', 'note', 'createdAt'])
        && request.resource.data.youtubeId is string && request.resource.data.youtubeId.matches('^[A-Za-z0-9_-]{6,20}$')
        && requestId == request.resource.data.language + '_' + request.resource.data.youtubeId
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.language in ['en-US', 'ru-RU', 'es-ES', 'fr-FR', 'de-DE', 'it-IT', 'pt-BR', 'ja-JP']
        && request.resource.data.note is string && request.resource.data.note.size() <= 200
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() <= 40;
    }
    // One tally for each day, for streaks: how many turns the learner spoke aloud.
    match /users/{uid}/days/{day} {
      allow read: if owns(uid);
      allow create, update: if owns(uid)
        && request.resource.data.keys().hasOnly(['day', 'spokenTurns', 'updatedAt'])
        && request.resource.data.keys().hasAll(['day', 'spokenTurns', 'updatedAt'])
        && request.resource.data.day == day && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.spokenTurns is int && request.resource.data.spokenTurns >= 0 && request.resource.data.spokenTurns <= 100000
        && request.resource.data.updatedAt is string && request.resource.data.updatedAt.size() <= 40;
    }
    // Time spent watching videos and recording. A log: written once, never changed.
    match /users/{uid}/activity/{activityId} {
      allow read: if owns(uid);
      allow create: if owns(uid) && validActivity(activityId);
    }
    // Mistakes the partner logged during conversations. Only the server writes them.
    match /users/{uid}/mistakes/{mistakeId} {
      allow read: if owns(uid);
    }
    // The "Watch and repeat" library is shared and filled by the owner's tooling.
    match /videos/{language}/items/{videoId} {
      allow read: if request.auth != null
        && language in ['en-US', 'ru-RU', 'es-ES', 'fr-FR', 'de-DE', 'it-IT', 'pt-BR', 'ja-JP'];
      allow create, update: if false;
      // Only an admin may take a video out of the library.
      allow delete: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // Who may manage shared content. Written only by the owner's tooling; an
    // account can see whether it is listed, and nothing else.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
    // Grammar is shared curriculum. Clients may read signed-in lessons but only
    // trusted server/admin tooling can create or change the content.
    match /grammar/{language}/topics/{topicId} {
      allow read: if request.auth != null
        && language in ['en-US', 'ru-RU', 'es-ES', 'fr-FR', 'de-DE', 'it-IT', 'pt-BR', 'ja-JP'];
      allow write: if false;
    }
    // Includes the server's private usage counters; clients can never change them.
    match /{document=**} { allow read, write: if false; }
  }
}
