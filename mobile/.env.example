# Firebase WEB app configuration from Project settings > Your apps.
# These identify the app; Firebase Auth and Firestore rules protect its data.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=europe-west2

# Local emulators only: must be used with a demo- project ID.
# EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1
# Never put provider secrets in any EXPO_PUBLIC_ variable.

# RevenueCat public SDK keys only. Leave unset until the store products and
# published legal pages are ready. Prices are loaded from the store, not code.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# Public OAuth client IDs for native Google sign-in. No client secrets in the app.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
