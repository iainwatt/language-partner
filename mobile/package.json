{
  "name": "language-partner",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-google-signin/google-signin": "^17.0.0",
    "expo": "~55.0.0",
    "expo-camera": "~55.0.23",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.40",
    "expo-font": "~55.0.8",
    "expo-keep-awake": "~55.0.8",
    "expo-media-library": "~55.0.21",
    "expo-secure-store": "~55.0.18",
    "expo-speech": "~55.0.18",
    "expo-speech-recognition": "^3.1.3",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.4",
    "firebase": "^12.19.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.3.2",
    "lucide-react-native": "^1.42.0",
    "react": "^19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.10",
    "react-native-purchases": "10.16.0",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "react-native-youtube-iframe": "^2.4.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/node": "^26.5.0",
    "@types/react": "~19.2.2",
    "@types/react-dom": "~19.2.0",
    "esbuild": "^0.28.2",
    "firebase-tools": "^15.30.0",
    "tsx": "^4.23.13",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "phone": "expo run:ios --device --configuration Release",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test",
    "eval": "node --import tsx evals/run.ts",
    "eval:script": "node --import tsx evals/run-script.ts",
    "eval:review": "node --import tsx evals/run-review.ts",
    "build:functions": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=cjs --outfile=functions/lib/index.js --external:firebase-admin/* --external:firebase-functions/*",
    "seed:grammar": "tsx scripts/seed-grammar.ts",
    "add:video": "tsx scripts/add-video.ts",
    "remove:video": "tsx scripts/remove-video.ts",
    "make:admin": "tsx scripts/make-admin.ts",
    "emulators": "npm run build:functions && firebase emulators:start --project demo-language-partner",
    "test:firebase": "npm run build:functions && firebase emulators:exec --project demo-language-partner --only auth,firestore,functions \"node --import tsx --test tests/firebase.integration.ts\"",
    "start:local": "node scripts/start-local.mjs"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  }
}
