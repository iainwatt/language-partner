{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true
  },
  "include": [
    "App.tsx",
    "index.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/**/*.ts",
    "server/**/*.ts",
    "evals/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "ios", "android", "dist", "artifacts"]
}
